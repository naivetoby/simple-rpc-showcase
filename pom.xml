<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>
    <groupId>example.showcase</groupId>
    <artifactId>simple-rpc-showcase</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>contracts</module>
        <module>gateway</module>
        <module>topic-service</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <simple-rpc.version>3.5.0</simple-rpc.version>
    </properties>

    <profiles>
        <profile>
            <id>native</id>
            <properties>
                <maven.compiler.proc>full</maven.compiler.proc>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.graalvm.buildtools</groupId>
                            <artifactId>native-maven-plugin</artifactId>
                            <configuration>
                                <buildArgs>
                                    <buildArg>--initialize-at-build-time=com.alibaba.fastjson2</buildArg>
                                </buildArgs>
                            </configuration>
                            <executions>
                                <execution>
                                    <id>compile-native-image</id>
                                    <phase>package</phase>
                                    <goals>
                                        <goal>compile-no-fork</goal>
                                    </goals>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
